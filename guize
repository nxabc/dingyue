  - RULE-SET,private_ip,DIRECT,no-resolve

  # 广告
  - RULE-SET,ads_domain,🛡️ 广告拦截

  # AI
  - RULE-SET,openai_domain,🤖 AI服务

  # GitHub
  - RULE-SET,github_domain,🐙 GitHub

  # Telegram
  - RULE-SET,telegram_domain,✈️ Telegram
  - RULE-SET,telegram_ip,✈️ Telegram,no-resolve

  # 国际媒体
  - RULE-SET,youtube_domain,📺 国际媒体
  - RULE-SET,netflix_domain,📺 国际媒体
  - RULE-SET,spotify_domain,📺 国际媒体

  # 国内媒体
  - RULE-SET,bilibili_domain,🎬 国内媒体

  # Microsoft
  - RULE-SET,onedrive_domain,Ⓜ️ 微软服务
  - RULE-SET,microsoft_domain,Ⓜ️ 微软服务

  # Apple
  - RULE-SET,apple_domain,🍎 Apple

  # Steam / 游戏
  - RULE-SET,steam_domain,🎮 游戏平台

  # 中国大陆域名/IP直连
  - RULE-SET,cn_domain,DIRECT
  - RULE-SET,cn_ip,DIRECT,no-resolve

  # 明确属于境外的域名
  - RULE-SET,geolocation_not_cn,🚀 节点选择

  # 最终兜底
  - MATCH,🐟 漏网之鱼
