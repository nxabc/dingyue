# ============================================================
# 3X-UI Clash / Mihomo 路由规则
# 用途：由 3X-UI 自动生成节点，本文件仅负责策略组与分流
# 不包含任何节点 IP / UUID / Reality / 订阅凭据
# ============================================================

proxy-groups:
  # 主代理组：自动包含 3X-UI 生成的所有代理节点
  - name: 🚀 节点选择
    type: select
    include-all: true
    proxies:
      - ♻️ 自动选择
      - DIRECT

  # 自动测速：选择延迟最低节点
  - name: ♻️ 自动选择
    type: url-test
    include-all: true
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    lazy: true

  - name: 🤖 AI服务
    type: select
    proxies:
      - 🚀 节点选择
      - ♻️ 自动选择
      - DIRECT

  - name: 📺 国际媒体
    type: select
    proxies:
      - 🚀 节点选择
      - ♻️ 自动选择

  - name: 🎬 国内媒体
    type: select
    proxies:
      - DIRECT
      - 🚀 节点选择

  - name: ✈️ Telegram
    type: select
    proxies:
      - 🚀 节点选择
      - ♻️ 自动选择

  - name: 🐙 GitHub
    type: select
    proxies:
      - 🚀 节点选择
      - ♻️ 自动选择
      - DIRECT

  - name: Ⓜ️ 微软服务
    type: select
    proxies:
      - DIRECT
      - 🚀 节点选择
      - ♻️ 自动选择

  - name: 🍎 Apple
    type: select
    proxies:
      - DIRECT
      - 🚀 节点选择

  - name: 🎮 游戏平台
    type: select
    proxies:
      - DIRECT
      - 🚀 节点选择
      - ♻️ 自动选择

  - name: 🛡️ 广告拦截
    type: select
    proxies:
      - REJECT
      - DIRECT

  - name: 🐟 漏网之鱼
    type: select
    proxies:
      - 🚀 节点选择
      - ♻️ 自动选择
      - DIRECT


